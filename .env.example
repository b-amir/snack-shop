# Example Environment Variables for SnackShop
# --------------------------------------------
# Copy this file to .env.local and fill in your actual values.
# DO NOT COMMIT .env.local to version control.



# --- Feature Flags ---
# Control optional features within the application.

NEXT_PUBLIC_USE_CLOUDINARY_CDN=true 



# --- Caching Configuration (Server-Side ONLY) ---
# Required ONLY if NEXT_PUBLIC_USE_CACHING=true.
# Format with password: redis://:password@hostname:port
# Format without password: redis://hostname:port

REDIS_URL=rediss://default:ATHCAAIjcDE2M2VjNzFmZGRjMzY0NjNkYWExNjIxYjI3MGFlYzc2MnAxMA@bright-flamingo-12738.upstash.io:6379



# --- Cloudinary Configuration ---
# CLOUDINARY_API_KEY=<your_cloudinary_api_key_if_managing_assets>
# CLOUDINARY_API_SECRET=<your_cloudinary_api_secret_if_managing_assets>
# CLOUDINARY_URL=cloudinary://<key>:<secret>@<cloud_name>

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=<your_cloudinary_cloud_name>



# --- Next.js On-Demand Revalidation (Server-Side ONLY) ---
# Required ONLY if you implement on-demand revalidation (e.g., via /api/revalidate).
# A secret token used to authorize requests to the revalidation endpoint.

REVALIDATE_SECRET_TOKEN=<generate_a_strong_random_secret>



# --- Deployment / Next.js Specific (Informational) ---

# NODE_ENV=development or production (Set by Next.js)
# PORT=3000 (Default dev port, managed by platform in production)
# VERCEL_URL=... (Set by Vercel during deployment)
